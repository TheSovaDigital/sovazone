{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/post",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<blogslug>[A-Za-z0-9_-]+)"
        }
      ],
      "destination": "/post/:blogslug",
      "permanent": true
    },
    {
      "source": "/en/post",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<blogslug>[A-Za-z0-9_-]+)"
        }
      ],
      "destination": "/en/post/:blogslug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    }
  ],
  "cleanUrls": true
}
